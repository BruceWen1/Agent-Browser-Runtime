@@ -0,0 +1,736 @@
+// -*- coding: utf-8 -*-
+// observer_transport.cc
+// Native observer private IPC transport
+// =====================
+// Authenticate an inherited bootstrap and enforce bounded current-user framing.
+
+#include "chrome/browser/abr_native_observer/observer_transport.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <string_view>
