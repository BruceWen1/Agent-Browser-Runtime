      "name": "browser_session_create",
      "inputSchema": {
        "type": "object",
        "properties": {
          "engine": {
            "enum": ["compatible", "gui", "native"]
          },
          "browser": {
            "enum": ["bundled-chromium", "installed-chrome", "custom-chromium"]
          },
          "profile": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": ["ephemeral", "persistent"]
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["mode"],
            "additionalProperties": false
          },
          "headless": {
            "type": "boolean"
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "allowedOrigins": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["engine", "browser", "profile"],
        "additionalProperties": false
      },
      "requiredCapability": null,
      "humanApproval": false,
      "risk": "normal"
    },
